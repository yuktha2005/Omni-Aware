# =============================================================================
# AI Multilingual Mass Communication Platform — Root Environment
# =============================================================================
# Copy this file to .env at the project root for Docker Compose deployment.

# PostgreSQL password (used by docker-compose db service)
POSTGRES_PASSWORD=change_me_secure_password

# JWT secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — set to your production domain when deploying
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

APP_ENV=production
